# Strapi API origin as a *browser* resolves it — client-side fetches and every
# <img> built by mediaUrl(). Use localhost for local dev; in production this is
# the CMS's public domain.
#
# Never http://cms:1337 here. That name resolves only inside the Docker network,
# so it would break every image on the site. Under Docker the *server* side is
# configured separately, by NUXT_STRAPI_URL in the root .env — see
# docker-compose.yml.
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API origin as *this process* reaches it — every server-rendered fetch.
# Same as the public URL for local dev, which is why it is commented out here;
# docker-compose.yml overrides it with http://cms:1337.
#NUXT_STRAPI_URL=http://localhost:1337

# Public origin of this site — used for canonical URLs, hreflang links, sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Which deployment this is. Anything other than "production" serves
# `Disallow: /` in robots.txt and `noindex` on every page — set it to "staging"
# on the staging instance, or search engines index it alongside the real site.
NUXT_SITE_ENV=production
