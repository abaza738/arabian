{
  "kind": "collectionType",
  "collectionName": "hubs",
  "info": {
    "singularName": "hub",
    "pluralName": "hubs",
    "displayName": "Hub",
    "description": "An airport the airline bases crew and aircraft at. Content may be scoped to one."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "icao": {
      "type": "string",
      "maxLength": 4,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iata": {
      "type": "string",
      "maxLength": 3,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "city": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "country": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "timezone": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "intro": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "location": {
      "type": "component",
      "repeatable": false,
      "component": "shared.location",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "hub"
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "hub"
    },
    "pilots": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pilot.pilot",
      "mappedBy": "hub"
    },
    "announcements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::announcement.announcement",
      "mappedBy": "hub"
    },
    "aircraft": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::aircraft.aircraft",
      "mappedBy": "hub"
    }
  }
}
