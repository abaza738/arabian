{
  "kind": "collectionType",
  "collectionName": "ranks",
  "info": {
    "singularName": "rank",
    "pluralName": "ranks",
    "displayName": "Rank",
    "description": "A rung on the crew ladder: what it is called and the hours it takes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "minHours": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "badge": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pilots": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pilot.pilot",
      "mappedBy": "rank"
    }
  }
}
