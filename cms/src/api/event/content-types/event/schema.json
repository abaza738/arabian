{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": "Something on the schedule: a group flight, a tour, a fly-in"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "startsAt": {
      "type": "datetime",
      "required": true
    },
    "endsAt": {
      "type": "datetime"
    },
    "location": {
      "type": "component",
      "repeatable": false,
      "component": "shared.location",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "eventStatus": {
      "type": "enumeration",
      "enum": ["scheduled", "postponed", "cancelled"],
      "default": "scheduled",
      "required": true
    },
    "registrationUrl": {
      "type": "string"
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "blocks": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "shared.media",
        "shared.quote",
        "shared.rich-text",
        "shared.slider"
      ]
    },
    "hub": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::hub.hub",
      "inversedBy": "events"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
