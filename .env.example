# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Strapi server
STRAPI_HOST=0.0.0.0
STRAPI_PORT=1337

# UI server
UI_PORT=3000

# Reverse proxy. Uncomment COMPOSE_PROFILES to have `docker compose up -d` also
# start Caddy, which terminates HTTPS for the two hostnames below and is the
# only thing that puts this site on the internet — everything else publishes to
# localhost. Both records must already point at this server: Caddy asks Let's
# Encrypt for a certificate the moment it boots.
# COMPOSE_PROFILES=proxy
SITE_DOMAIN=
CMS_DOMAIN=

# Public origin of this site. Read at BUILD time as well as at runtime, so
# changing it needs `docker compose up -d --build ui`, not just a restart.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

NUXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Anything other than `production` serves `Disallow: /` and `noindex`.
NUXT_SITE_ENV=production

# Strapi secrets — generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
# Required, not optional — the users-permissions plugin refuses to boot without it.
JWT_SECRET=
